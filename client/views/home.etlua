<link rel="stylesheet" href="/static/css/home.css">

<section class="title">
  <h1>Welcome<%if user then %> <em><%=user.username%></em><% end %>!</h1>
  <p>...</p>
</section>

<section>
<!-- same as above but using the element functions make it, sometimes nicer -->
 <!-- element("h1", ) -->
  <h1>Welcome <% if user then element("em", user.username) end %>!</h1>
  <p>..</p>
  <img src="favicon.ico">
</section>
