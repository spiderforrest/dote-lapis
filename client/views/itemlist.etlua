<Itemlist>
  <!-- render items is just the list of items for this to render -->
  <ul>
  <% for i,id in ipairs(render_items) do %>
    <% local item = user.items[id] %>

    <li class="item" style="display: flex; flex-direction: row;">

      <a style="color:blue;" href=<%= url_for("item-uuid", {uuid=item.uuid}) %> >
        <h6><%=item.id%></h6>
      </a>

      <h4><%=item.title%></h4>

      <% if item.body then %>
        <p><%= item.body %> </p>
      <% end %>

    </li>

  <% end %>
  </ul>
</Itemlist>
