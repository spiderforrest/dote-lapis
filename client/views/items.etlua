<link rel="stylesheet" href="/static/css/itemlist.css">
<link rel="stylesheet" href="/static/css/itemcard.css">

<Items>
  <form action=<%= url_for"item-search" %> method="get">
    <input name="search"></input>
    <button>Search items</button>
  </form>
  <% for _, item in ipairs(user.items) do
    render("client.views.itemcard", {id = item.id, rendered = {}})
  end %>
</Items>
